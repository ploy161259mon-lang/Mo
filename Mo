-- ====================================================================
-- [ส่วนที่ 3] ฟังก์ชันระบบเช็คผลและเสกโมเดลผลไม้เข้าตัว (Client-Side Spawn)
-- ====================================================================
function SpawnPremiumFruit(requestedFruitName)
    -- ตรวจสอบว่าผลไม้ที่กรอกเข้ามา อยู่ในเงื่อนไข "ระดับม่วงขึ้นไป" หรือไม่
    local fruitData = PremiumFruitList[requestedFruitName]
    
    if fruitData then
        print("======== ตรวจสอบพบผลไม้ระดับสูง ========")
        print("ชื่อผลไม้: " .. fruitData.Name)
        print("ระดับความหายาก: " .. fruitData.Rarity)
        
        -- จำลองการสร้างโมเดลผลไม้เข้าไปในกระเป๋า (Backpack) ของผู้เล่น
        local Tool = Instance.new("Tool")
        Tool.Name = "🔥 " .. fruitData.Name .. " [" .. fruitData.Rarity .. "]"
        
        local Handle = Instance.new("Part")
        Handle.Name = "Handle"
        Handle.Size = Vector3.new(1, 1, 1)
        Handle.BrickColor = BrickColor.new("Bright violet") -- ใส่สีม่วง/แดงให้ตัวผลไม้
        Handle.Parent = Tool
        
        -- ส่งผลไม้เข้าตัวผู้เล่น
        Tool.Parent = game.Players.LocalPlayer.Backpack
        return true
    else
        print("⚠️ ระบบปฏิเสธ: ผลไม้นี้ไม่อยู่ในรายชื่อ หรือระดับต่ำกว่าสีม่วง!")
        return false
    end
end

-- ====================================================================
-- [ส่วนที่ 4] ตัวอย่างวิธีเรียกใช้งานสคริปต์
-- ====================================================================
-- ตัวอย่างที่ 1: สั่งเสกผลคิซึเนะ (ผ่านเงื่อนไขเพราะระดับสีแดง)
SpawnPremiumFruit("Kitsune Fruit") 

-- ตัวอย่างที่ 2: สั่งเสกผลประตู Portal (ผ่านเงื่อนไขเพราะระดับสีม่วง)
SpawnPremiumFruit("Portal Fruit")

-- ตัวอย่างที่ 3: สั่งเสกผลระดับต่ำ เช่น ผลระเบิด Bomb (จะถูกระบบปฏิเสธและไม่ยอมเสกให้)
SpawnPremiumFruit("Bomb Fruit")

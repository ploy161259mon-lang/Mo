-- ====================================================================
-- [ส่วนที่ 1] ระบบ Auto Farm & โจมตีความเร็วสูง (Fast Attack)
-- ====================================================================
local FastAttackEnabled = true
local AttackSpeed = 0.05 -- ค่าความเร็วในการโจมตี (ยิ่งน้อยยิ่งรัว)

task.spawn(function()
    while task.wait(AttackSpeed) do
        if FastAttackEnabled then
            pcall(function()
                -- สั่งการโจมตีความเร็วสูงไปที่มอนสเตอร์รอบตัว
                local CombatFramework = require(game:GetService("Players").LocalPlayer.PlayerScripts.CombatFramework)
                local CurrentWeapon = CombatFramework.activeController.currentWeaponModel
                if CurrentWeapon then
                    -- คำสั่งรันความเร็วในการฟันดาบ/หมัดแบบรัวๆ
                    CombatFramework.activeController.attack()
                end
            end)
        end
    end
end)

